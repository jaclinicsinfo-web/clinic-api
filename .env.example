# Porta da API
PORT=3001
NODE_ENV=development

# Banco PostgreSQL (Render).
# Dev local: use o hostname EXTERNO + ?sslmode=require
# Produção (API no Render): use o hostname INTERNO + ?sslmode=require
DATABASE_URL="postgresql://USUARIO:SENHA@HOST.ohio-postgres.render.com/BANCO?sslmode=require"

# JWT
JWT_SECRET=troque-em-producao-clinicerp
JWT_EXPIRES_IN=12h
JWT_EXPIRES_IN_LEMBRAR=7d

# URLs / CORS (painel Next.js)
# Em produção no Render, use as URLs públicas (sem barra no final).
FRONTEND_URL=https://clinic-web-app-q4mc.onrender.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,https://clinic-web-app-q4mc.onrender.com

# Plano da clínica neste deploy. O cliente NÃO escolhe no painel.
# essencial (5 usuários) | profissional (20) | ilimitado
PLANO=essencial

# Chave residual do POST /api/cadastro (landing). Sem landing, pode manter qualquer valor.
LANDING_API_KEY=troque-esta-chave-da-landing

# E-mail (recuperação de senha e fallback dos lembretes). Sem SMTP o pedido ainda é aceito, mas o link só aparece no log em desenvolvimento.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=J.A. Clinics <nao-responda@clinica.com.br>

# Integrações (WhatsApp Cloud API / lembretes)
# URL pública da API (usada para montar o webhook da Meta). Em branco, usa o host da requisição.
API_PUBLIC_URL=
# Chave AES para cifrar tokens/senhas no banco. Se vazia, usa JWT_SECRET.
CREDENTIALS_KEY=
# Versão da Graph API da Meta
META_GRAPH_VERSION=v21.0
# Intervalo do processador interno de lembretes (ms)
INTEGRACOES_INTERVALO_MS=60000

# Custos de repasse por disparo (R$). A clínica NÃO edita no painel — só vocês no deploy.
# Ajuste quando a tabela da Meta/provedor SMTP mudar.
CUSTO_WHATSAPP_UTILITY=0
CUSTO_WHATSAPP_MARKETING=0
CUSTO_WHATSAPP_AUTHENTICATION=0
CUSTO_WHATSAPP_SERVICE=0
CUSTO_EMAIL=0
