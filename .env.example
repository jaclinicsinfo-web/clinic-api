# Porta da API
PORT=3001
NODE_ENV=development

# Banco PostgreSQL (Render).
# Dev local: use o hostname EXTERNO + ?sslmode=require
# Produção (API no Render): use o hostname INTERNO + ?sslmode=require
DATABASE_URL="postgresql://USUARIO:SENHA@HOST.ohio-postgres.render.com/BANCO?sslmode=require"

# JWT
JWT_SECRET=troque-em-producao-clinicerp
JWT_EXPIRES_IN=12h
JWT_EXPIRES_IN_LEMBRAR=7d

# URLs / CORS (painel Next.js)
# Em produção no Render, use as URLs públicas (sem barra no final).
FRONTEND_URL=https://clinic-web-app-q4mc.onrender.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,https://clinic-web-app-q4mc.onrender.com

# Plano da clínica neste deploy. O cliente NÃO escolhe no painel.
# essencial (5 usuários) | profissional (20) | ilimitado
PLANO=essencial

# Chave residual do POST /api/cadastro (landing). Sem landing, pode manter qualquer valor.
LANDING_API_KEY=troque-esta-chave-da-landing

# E-mail (recuperação de senha). Sem SMTP o pedido ainda é aceito, mas o link só aparece no log em desenvolvimento.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=J.A. Clinics <nao-responda@clinica.com.br>
