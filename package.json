{
  "name": "clinicerp-api",
  "version": "1.0.0",
  "description": "API REST do ClinicERP - autenticação, cadastro pós-compra e planos",
  "main": "dist/server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "postinstall": "npm run build",
    "start": "node dist/server.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "test": "node --require ts-node/register --test src/lib/segredo.test.ts src/lib/integracoes/lembretes.test.ts src/lib/assinatura.test.ts src/lib/mercadopago.test.ts src/lib/cobranca/cobranca.test.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "keywords": [
    "clinicerp",
    "api",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.1.0",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
