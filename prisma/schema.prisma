generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plano {
  id             String    @id @default(uuid()) @db.Uuid
  codigo         String    @unique
  nome           String
  limiteUsuarios Int?
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  clinicas       Clinica[]

  @@map("planos")
}

model Clinica {
  id           String   @id @default(uuid()) @db.Uuid
  nomeFantasia String
  razaoSocial  String
  cnpj         String   @unique
  telefone     String
  email        String
  planoId      String   @db.Uuid
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  plano         Plano          @relation(fields: [planoId], references: [id])
  unidades      Unidade[]
  perfisAcesso  PerfilAcesso[]
  usuarios      Usuario[]

  @@map("clinicas")
}

model Unidade {
  id        String  @id @default(uuid()) @db.Uuid
  clinicaId String  @db.Uuid
  nome      String
  cidade    String
  ativo     Boolean @default(true)

  clinica         Clinica          @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  usuarioUnidades UsuarioUnidade[]

  @@map("unidades")
}

model PerfilAcesso {
  id          String  @id @default(uuid()) @db.Uuid
  clinicaId   String  @db.Uuid
  nome        String
  descricao   String
  sistema     Boolean @default(false)
  permissoes  Json

  clinica  Clinica   @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  usuarios Usuario[]

  @@map("perfis_acesso")
}

model Usuario {
  id           String    @id @default(uuid()) @db.Uuid
  clinicaId    String    @db.Uuid
  nome         String
  email        String    @unique
  senhaHash    String
  perfilId     String    @db.Uuid
  status       String    @default("ativo")
  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  clinica         Clinica          @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  perfil          PerfilAcesso     @relation(fields: [perfilId], references: [id])
  usuarioUnidades UsuarioUnidade[]

  @@map("usuarios")
}

model UsuarioUnidade {
  usuarioId String @db.Uuid
  unidadeId String @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, unidadeId])
  @@map("usuarios_unidades")
}
