generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plano {
  id             String   @id @default(uuid()) @db.Uuid
  codigo         String   @unique
  nome           String
  limiteUsuarios Int?
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  clinicas Clinica[]

  @@map("planos")
}

model Clinica {
  id           String   @id @default(uuid()) @db.Uuid
  nomeFantasia String
  razaoSocial  String
  cnpj         String   @unique
  telefone     String
  email        String
  cep          String?
  rua          String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  uf           String?
  logoMime     String?
  logoBytes    Bytes?
  planoId      String   @db.Uuid
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  plano               Plano                    @relation(fields: [planoId], references: [id])
  unidades            Unidade[]
  perfisAcesso        PerfilAcesso[]
  usuarios            Usuario[]
  convenios           Convenio[]
  pacientes           Paciente[]
  procedimentos       Procedimento[]
  profissionais       Profissional[]
  agendamentos        Agendamento[]
  bloqueiosAgenda     BloqueioAgenda[]
  listaEspera         ListaEsperaItem[]
  acompanhamentos     AcompanhamentoClinico[]
  atendimentos        Atendimento[]
  documentosPaciente  DocumentoPaciente[]
  logsProntuario      LogAcessoProntuario[]
  formasPagamento      FormaPagamento[]
  cobrancas            Cobranca[]
  despesas             Despesa[]
  lotesConvenio        LoteConvenio[]
  comissoes            Comissao[]
  produtosEstoque      ProdutoEstoque[]
  movimentacoesEstoque MovimentacaoEstoque[]
  notificacoes         Notificacao[]
  registrosPonto       RegistroPonto[]
  holerites            Holerite[]
  integracao           IntegracaoClinica?
  regrasLembrete       RegraLembrete[]
  templatesMensagem    TemplateMensagem[]
  custosEnvio          CustoEnvio[]
  enviosLembrete       EnvioLembrete[]

  @@map("clinicas")
}

model Unidade {
  id        String  @id @default(uuid()) @db.Uuid
  clinicaId String  @db.Uuid
  nome      String
  cidade    String
  ativo     Boolean @default(true)

  clinica         Clinica          @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  usuarioUnidades UsuarioUnidade[]
  pacientes       Paciente[]
  agendamentos    Agendamento[]
  listaEspera     ListaEsperaItem[]
  cobrancas            Cobranca[]
  despesas             Despesa[]
  movimentacoesEstoque MovimentacaoEstoque[]

  @@map("unidades")
}

model PerfilAcesso {
  id         String  @id @default(uuid()) @db.Uuid
  clinicaId  String  @db.Uuid
  nome       String
  descricao  String
  sistema    Boolean @default(false)
  permissoes Json

  clinica  Clinica   @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  usuarios Usuario[]

  @@map("perfis_acesso")
}

model Usuario {
  id           String    @id @default(uuid()) @db.Uuid
  clinicaId    String    @db.Uuid
  nome         String
  email        String    @unique
  senhaHash    String
  perfilId     String    @db.Uuid
  status       String    @default("ativo")
  tema         String    @default("claro")
  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  clinica             Clinica              @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  perfil              PerfilAcesso         @relation(fields: [perfilId], references: [id])
  usuarioUnidades     UsuarioUnidade[]
  profissional        Profissional?
  agendamentosCriados Agendamento[]        @relation("AgendamentoCriadoPor")
  atendimentosCriados Atendimento[]        @relation("AtendimentoCriadoPor")
  documentosEnviados      DocumentoPaciente[]     @relation("DocumentoCriadoPor")
  logsProntuario          LogAcessoProntuario[]
  recuperacoesSenha       RecuperacaoSenha[]
  notificacoes            Notificacao[]
  movimentacoesEstoque    MovimentacaoEstoque[]
  registrosPonto          RegistroPonto[] @relation("PontoUsuario")
  pontosRegistrados       RegistroPonto[] @relation("PontoRegistradoPor")
  holerites               Holerite[]      @relation("HoleriteUsuario")
  holeritesEnviados       Holerite[]      @relation("HoleriteCriadoPor")

  @@map("usuarios")
}

model UsuarioUnidade {
  usuarioId String @db.Uuid
  unidadeId String @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, unidadeId])
  @@map("usuarios_unidades")
}

model Convenio {
  id                     String   @id @default(uuid()) @db.Uuid
  clinicaId              String   @db.Uuid
  nome                   String
  registroAns            String?
  prazoPagamentoDias     Int      @default(30)
  exigeAutorizacaoPrevia Boolean  @default(false)
  contatoNome            String   @default("")
  contatoTelefone        String   @default("")
  portalUrl              String?
  status                 String   @default("ativo")
  criadoEm               DateTime @default(now())
  atualizadoEm           DateTime @updatedAt

  clinica      Clinica                @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  pacientes    Paciente[]
  tabelaPrecos ConvenioProcedimento[]
  agendamentos Agendamento[]
  cobrancas    Cobranca[]
  lotes        LoteConvenio[]

  @@unique([clinicaId, nome])
  @@index([clinicaId, status])
  @@map("convenios")
}

model Procedimento {
  id               String   @id @default(uuid()) @db.Uuid
  clinicaId        String   @db.Uuid
  nome             String
  categoria        String
  duracaoPadraoMin Int
  valorParticular  Decimal  @db.Decimal(12, 2)
  status           String   @default("ativo")
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  clinica         Clinica                     @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  valoresConvenio ConvenioProcedimento[]
  profissionais        ProfissionalProcedimento[]
  agendamentos         Agendamento[]
  listaEspera          ListaEsperaItem[]
  movimentacoesEstoque MovimentacaoEstoque[]

  @@unique([clinicaId, nome])
  @@index([clinicaId, status])
  @@map("procedimentos")
}

model ConvenioProcedimento {
  convenioId     String  @db.Uuid
  procedimentoId String  @db.Uuid
  valor          Decimal @db.Decimal(12, 2)

  convenio     Convenio     @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  procedimento Procedimento @relation(fields: [procedimentoId], references: [id], onDelete: Cascade)

  @@id([convenioId, procedimentoId])
  @@map("convenio_procedimentos")
}

model Profissional {
  id                      String   @id @default(uuid()) @db.Uuid
  clinicaId               String   @db.Uuid
  usuarioId               String?  @unique @db.Uuid
  nome                    String
  cpf                     String
  rg                      String?
  email                   String
  telefone                String
  fotoUrl                 String?
  especialidades          String[]
  conselho                String
  registroConselho        String
  tipoVinculo             String
  formaRemuneracao        String
  dataAdmissao            DateTime @db.Date
  percentualComissao      Decimal  @default(0) @db.Decimal(5, 2)
  comissaoPorProcedimento Boolean  @default(false)
  status                  String   @default("ativo")
  criadoEm                DateTime @default(now())
  atualizadoEm            DateTime @updatedAt

  clinica             Clinica                    @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  usuario             Usuario?                   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  procedimentos       ProfissionalProcedimento[]
  gradeHorarios       ProfissionalHorario[]
  pacientesPreferidos Paciente[]                 @relation("PacienteProfissionalPreferido")
  agendamentos        Agendamento[]
  bloqueios           BloqueioAgenda[]
  listaEspera         ListaEsperaItem[]
  acompanhamentos     AcompanhamentoClinico[]
  atendimentos        Atendimento[]
  comissoes           Comissao[]

  @@unique([clinicaId, cpf])
  @@index([clinicaId, status])
  @@map("profissionais")
}

model ProfissionalHorario {
  id             String @id @default(uuid()) @db.Uuid
  profissionalId String @db.Uuid
  diaSemana      Int
  horaInicio     String
  horaFim        String

  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@unique([profissionalId, diaSemana])
  @@map("profissional_horarios")
}

model ProfissionalProcedimento {
  profissionalId String @db.Uuid
  procedimentoId String @db.Uuid

  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  procedimento Procedimento @relation(fields: [procedimentoId], references: [id], onDelete: Cascade)

  @@id([profissionalId, procedimentoId])
  @@map("profissional_procedimentos")
}

model Paciente {
  id                      String    @id @default(uuid()) @db.Uuid
  clinicaId               String    @db.Uuid
  unidadeId               String    @db.Uuid
  nome                    String
  cpf                     String
  rg                      String?
  dataNascimento          DateTime  @db.Date
  sexo                    String
  estadoCivil             String?
  profissao               String?
  telefone                String
  whatsapp                String?
  email                   String?
  cep                     String
  rua                     String
  numero                  String
  complemento             String?
  bairro                  String
  cidade                  String
  uf                      String
  convenioId              String?   @db.Uuid
  numeroCarteirinha       String?
  validadeCarteirinha     DateTime? @db.Date
  responsavelNome         String?
  responsavelCpf          String?
  responsavelParentesco   String?
  responsavelTelefone     String?
  alergias                String[]  @default([])
  condicoesPreexistentes  String[]  @default([])
  medicacoesEmUso         String[]  @default([])
  profissionalPreferidoId String?   @db.Uuid
  formaContatoPreferida   String?
  observacoes             String?
  consentimentoLgpd       Boolean
  autorizacaoImagem       Boolean   @default(false)
  status                  String    @default("ativo")
  criadoEm                DateTime  @default(now())
  atualizadoEm            DateTime  @updatedAt

  clinica               Clinica                 @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  unidade               Unidade                 @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  convenio              Convenio?               @relation(fields: [convenioId], references: [id], onDelete: SetNull)
  profissionalPreferido Profissional?           @relation("PacienteProfissionalPreferido", fields: [profissionalPreferidoId], references: [id], onDelete: SetNull)
  agendamentos          Agendamento[]
  listaEspera           ListaEsperaItem[]
  acompanhamentos       AcompanhamentoClinico[]
  atendimentos          Atendimento[]
  documentos            DocumentoPaciente[]
  logsProntuario        LogAcessoProntuario[]
  cobrancas             Cobranca[]

  @@unique([clinicaId, cpf])
  @@index([clinicaId, unidadeId])
  @@index([clinicaId, profissionalPreferidoId])
  @@index([clinicaId, status])
  @@index([clinicaId, nome])
  @@map("pacientes")
}

model Agendamento {
  id              String   @id @default(uuid()) @db.Uuid
  clinicaId       String   @db.Uuid
  unidadeId       String   @db.Uuid
  pacienteId      String   @db.Uuid
  profissionalId  String   @db.Uuid
  procedimentoId  String   @db.Uuid
  data            DateTime @db.Date
  horaInicio      String
  horaFim         String
  sala            String?
  convenioId      String?  @db.Uuid
  particular      Boolean
  tipo            String   @default("atendimento")
  valor           Decimal  @db.Decimal(12, 2)
  status          String
  observacoes     String?
  lembreteEnviado Boolean  @default(false)
  criadoPorId     String   @db.Uuid
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  clinica      Clinica       @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  unidade      Unidade       @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  paciente     Paciente      @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  profissional Profissional  @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  procedimento Procedimento  @relation(fields: [procedimentoId], references: [id], onDelete: Restrict)
  convenio     Convenio?     @relation(fields: [convenioId], references: [id], onDelete: SetNull)
  criadoPor    Usuario       @relation("AgendamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  atendimento  Atendimento?
  cobranca     Cobranca?
  enviosLembrete EnvioLembrete[]

  @@index([clinicaId, data])
  @@index([clinicaId, profissionalId, data])
  @@index([clinicaId, pacienteId])
  @@index([clinicaId, status])
  @@map("agendamentos")
}

model BloqueioAgenda {
  id             String   @id @default(uuid()) @db.Uuid
  clinicaId      String   @db.Uuid
  profissionalId String   @db.Uuid
  data           DateTime @db.Date
  horaInicio     String
  horaFim        String
  motivo         String
  criadoEm       DateTime @default(now())

  clinica      Clinica      @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([clinicaId, profissionalId, data])
  @@map("bloqueios_agenda")
}

model ListaEsperaItem {
  id                 String   @id @default(uuid()) @db.Uuid
  clinicaId          String   @db.Uuid
  unidadeId          String   @db.Uuid
  pacienteId         String   @db.Uuid
  profissionalId     String?  @db.Uuid
  procedimentoId     String?  @db.Uuid
  preferenciaPeriodo String
  status             String   @default("aguardando")
  criadoEm           DateTime @default(now())

  clinica      Clinica       @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  unidade      Unidade       @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  paciente     Paciente      @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  profissional Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  procedimento Procedimento? @relation(fields: [procedimentoId], references: [id], onDelete: SetNull)

  @@index([clinicaId, status])
  @@map("lista_espera")
}

model AcompanhamentoClinico {
  id             String    @id @default(uuid()) @db.Uuid
  clinicaId      String    @db.Uuid
  pacienteId     String    @db.Uuid
  profissionalId String    @db.Uuid
  especialidade  String
  titulo         String
  queixaInicial  String
  quadroInicial  String
  objetivo       String?
  status         String    @default("em_andamento")
  inicioEm       DateTime  @db.Date
  altaEm         DateTime? @db.Date
  resumoAlta     String?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  clinica      Clinica      @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  paciente     Paciente     @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  atendimentos Atendimento[]

  @@index([clinicaId, pacienteId])
  @@map("acompanhamentos_clinicos")
}

model Atendimento {
  id                     String    @id @default(uuid()) @db.Uuid
  clinicaId              String    @db.Uuid
  agendamentoId          String?   @unique @db.Uuid
  acompanhamentoId       String?   @db.Uuid
  pacienteId             String    @db.Uuid
  profissionalId         String    @db.Uuid
  data                   DateTime  @db.Date
  procedimentoRealizado  String
  tipoRegistro           String
  queixaPrincipal        String?
  quadroClinico          String?
  evolucao               String
  conduta                String?
  respostaAoTratamento   String?
  escalaDor              Int?
  proximoRetornoSugerido DateTime? @db.Date
  criadoPorId            String    @db.Uuid
  criadoEm               DateTime  @default(now())

  clinica        Clinica                 @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  agendamento    Agendamento?            @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  acompanhamento AcompanhamentoClinico?  @relation(fields: [acompanhamentoId], references: [id], onDelete: SetNull)
  paciente       Paciente                @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  profissional   Profissional            @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  criadoPor      Usuario                 @relation("AtendimentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  anexos         DocumentoPaciente[]

  @@index([clinicaId, pacienteId])
  @@index([acompanhamentoId])
  @@map("atendimentos")
}

model DocumentoPaciente {
  id            String   @id @default(uuid()) @db.Uuid
  clinicaId     String   @db.Uuid
  pacienteId    String   @db.Uuid
  atendimentoId String?  @db.Uuid
  nome          String
  tipo          String
  origem        String
  mimeType      String
  tamanhoKb     Int
  conteudo      Bytes
  criadoPorId   String   @db.Uuid
  criadoEm      DateTime @default(now())

  clinica     Clinica      @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  paciente    Paciente     @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  atendimento Atendimento? @relation(fields: [atendimentoId], references: [id], onDelete: SetNull)
  criadoPor   Usuario      @relation("DocumentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@index([clinicaId, pacienteId])
  @@map("documentos_paciente")
}

model LogAcessoProntuario {
  id         String   @id @default(uuid()) @db.Uuid
  clinicaId  String   @db.Uuid
  pacienteId String   @db.Uuid
  usuarioId  String   @db.Uuid
  acao       String
  criadoEm   DateTime @default(now())

  clinica  Clinica  @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([clinicaId, pacienteId, criadoEm])
  @@map("logs_acesso_prontuario")
}

model FormaPagamento {
  id        String  @id @default(uuid()) @db.Uuid
  clinicaId String  @db.Uuid
  codigo    String
  nome      String
  taxa      Decimal @default(0) @db.Decimal(5, 2)
  ativo     Boolean @default(true)
  ordem     Int     @default(0)

  clinica Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@unique([clinicaId, codigo])
  @@index([clinicaId, ativo])
  @@map("formas_pagamento")
}

model Cobranca {
  id             String    @id @default(uuid()) @db.Uuid
  clinicaId      String    @db.Uuid
  unidadeId      String    @db.Uuid
  pacienteId     String    @db.Uuid
  agendamentoId  String?   @unique @db.Uuid
  descricao      String
  valor          Decimal   @db.Decimal(12, 2)
  formaPagamento String?
  convenioId     String?   @db.Uuid
  status         String    @default("pendente")
  vencimento     DateTime  @db.Date
  pagoEm         DateTime? @db.Date
  observacoes    String?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  clinica     Clinica           @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  unidade     Unidade           @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  paciente    Paciente          @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  agendamento Agendamento?      @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  convenio    Convenio?         @relation(fields: [convenioId], references: [id], onDelete: SetNull)
  parcelas    ParcelaCobranca[]
  lotes       LoteGuia[]

  @@index([clinicaId, status])
  @@index([clinicaId, vencimento])
  @@index([clinicaId, pacienteId])
  @@map("cobrancas")
}

model ParcelaCobranca {
  id             String    @id @default(uuid()) @db.Uuid
  cobrancaId     String    @db.Uuid
  numero         Int
  valor          Decimal   @db.Decimal(12, 2)
  vencimento     DateTime  @db.Date
  status         String    @default("pendente")
  pagoEm         DateTime? @db.Date
  formaPagamento String?

  cobranca Cobranca @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)

  @@unique([cobrancaId, numero])
  @@map("parcelas_cobranca")
}

model Despesa {
  id             String    @id @default(uuid()) @db.Uuid
  clinicaId      String    @db.Uuid
  unidadeId      String    @db.Uuid
  descricao      String
  categoria      String
  fornecedor     String
  valor          Decimal   @db.Decimal(12, 2)
  vencimento     DateTime  @db.Date
  status         String    @default("a_pagar")
  recorrente     Boolean   @default(false)
  formaPagamento String?
  pagoEm         DateTime? @db.Date
  observacoes    String?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  clinica Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Restrict)

  @@index([clinicaId, status])
  @@index([clinicaId, vencimento])
  @@map("despesas")
}

model LoteConvenio {
  id                String    @id @default(uuid()) @db.Uuid
  clinicaId         String    @db.Uuid
  convenioId        String    @db.Uuid
  competencia       String
  status            String    @default("aberto")
  valorApresentado  Decimal   @db.Decimal(12, 2)
  valorGlosado      Decimal   @default(0) @db.Decimal(12, 2)
  valorRecebido     Decimal   @default(0) @db.Decimal(12, 2)
  enviadoEm         DateTime? @db.Date
  previsaoPagamento DateTime? @db.Date
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  clinica  Clinica    @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  convenio Convenio   @relation(fields: [convenioId], references: [id], onDelete: Restrict)
  guias    LoteGuia[]

  @@unique([clinicaId, convenioId, competencia])
  @@index([clinicaId, competencia])
  @@map("lotes_convenio")
}

model LoteGuia {
  loteId     String @db.Uuid
  cobrancaId String @db.Uuid

  lote     LoteConvenio @relation(fields: [loteId], references: [id], onDelete: Cascade)
  cobranca Cobranca     @relation(fields: [cobrancaId], references: [id], onDelete: Restrict)

  @@id([loteId, cobrancaId])
  @@map("lote_guias")
}

model Comissao {
  id                String    @id @default(uuid()) @db.Uuid
  clinicaId         String    @db.Uuid
  profissionalId    String    @db.Uuid
  competencia       String
  atendimentos      Int
  faturamentoGerado Decimal   @db.Decimal(12, 2)
  percentual        Decimal   @db.Decimal(5, 2)
  valorComissao     Decimal   @db.Decimal(12, 2)
  status            String    @default("prevista")
  pagoEm            DateTime? @db.Date
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  clinica      Clinica      @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Restrict)

  @@unique([clinicaId, profissionalId, competencia])
  @@index([clinicaId, competencia])
  @@map("comissoes")
}

model ProdutoEstoque {
  id               String   @id @default(uuid()) @db.Uuid
  clinicaId        String   @db.Uuid
  nome             String
  categoria        String
  unidadeMedida    String
  quantidadeAtual  Decimal  @default(0) @db.Decimal(12, 2)
  estoqueMinimo    Decimal  @db.Decimal(12, 2)
  custoUnitario    Decimal  @db.Decimal(12, 2)
  fornecedor       String
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  clinica       Clinica                 @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  movimentacoes MovimentacaoEstoque[]

  @@unique([clinicaId, nome])
  @@index([clinicaId, ativo])
  @@map("produtos_estoque")
}

model MovimentacaoEstoque {
  id             String   @id @default(uuid()) @db.Uuid
  clinicaId      String   @db.Uuid
  unidadeId      String   @db.Uuid
  produtoId      String   @db.Uuid
  tipo           String
  quantidade     Decimal  @db.Decimal(12, 2)
  motivo         String
  procedimentoId String?  @db.Uuid
  usuarioId      String   @db.Uuid
  data           DateTime @db.Date
  criadoEm       DateTime @default(now())

  clinica      Clinica         @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  unidade      Unidade         @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  produto      ProdutoEstoque  @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  procedimento Procedimento?   @relation(fields: [procedimentoId], references: [id], onDelete: SetNull)
  usuario      Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([clinicaId, data])
  @@index([produtoId])
  @@map("movimentacoes_estoque")
}

model RecuperacaoSenha {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @db.Uuid
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("recuperacoes_senha")
}

model Notificacao {
  id         String    @id @default(uuid()) @db.Uuid
  clinicaId  String    @db.Uuid
  usuarioId  String    @db.Uuid
  chave      String
  tipo       String
  titulo     String
  descricao  String
  href       String?
  severidade String    @default("media")
  lidaEm     DateTime?
  criadoEm   DateTime  @default(now())

  clinica Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, chave])
  @@index([usuarioId, lidaEm, criadoEm])
  @@map("notificacoes")
}

model RegistroPonto {
  id               String    @id @default(uuid()) @db.Uuid
  clinicaId        String    @db.Uuid
  usuarioId        String    @db.Uuid
  data             DateTime  @db.Date
  entrada          String?
  saidaIntervalo   String?
  retornoIntervalo String?
  saida            String?
  observacao       String?
  origem           String    @default("manual")
  registradoPorId  String    @db.Uuid
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  clinica       Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  usuario       Usuario @relation("PontoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  registradoPor Usuario @relation("PontoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@unique([clinicaId, usuarioId, data])
  @@index([clinicaId, data])
  @@map("registros_ponto")
}

model Holerite {
  id          String   @id @default(uuid()) @db.Uuid
  clinicaId   String   @db.Uuid
  usuarioId   String   @db.Uuid
  competencia String
  nomeArquivo String
  mimeType    String
  tamanhoKb   Int
  conteudo    Bytes
  criadoPorId String   @db.Uuid
  criadoEm    DateTime @default(now())

  clinica   Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  usuario   Usuario @relation("HoleriteUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoPor Usuario @relation("HoleriteCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@unique([clinicaId, usuarioId, competencia])
  @@index([clinicaId, competencia])
  @@map("holerites")
}

model IntegracaoClinica {
  id        String @id @default(uuid()) @db.Uuid
  clinicaId String @unique @db.Uuid

  lembretesAtivos Boolean @default(false)

  whatsappAtivo              Boolean @default(false)
  whatsappPhoneNumberId      String?
  whatsappWabaId             String?
  whatsappAppId              String?
  whatsappAccessTokenCifrado String?
  whatsappAppSecretCifrado   String?
  whatsappVerifyTokenCifrado String?
  whatsappAmbiente           String  @default("producao")
  whatsappCobrancaModo       String  @default("conta_clinica")

  emailAtivo         Boolean @default(false)
  smtpHost           String?
  smtpPort           Int?
  smtpUsuario        String?
  smtpSenhaCifrada   String?
  smtpRemetente      String?
  smtpRemetenteNome  String?
  smtpSeguro         String  @default("tls")
  emailCobrancaModo  String  @default("conta_clinica")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clinica Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@map("integracoes_clinica")
}

model RegraLembrete {
  id                   String  @id @default(uuid()) @db.Uuid
  clinicaId            String  @db.Uuid
  nome                 String
  tipo                 String
  antecedenciaMinutos  Int?
  destinatarios        String
  canais               String[]
  templateWhatsappId   String? @db.Uuid
  templateEmailId      String? @db.Uuid
  ativo                Boolean @default(true)
  sistema              Boolean @default(false)
  ordem                Int     @default(0)
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  clinica          Clinica            @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  templateWhatsapp TemplateMensagem?  @relation("RegraTemplateWhatsapp", fields: [templateWhatsappId], references: [id], onDelete: SetNull)
  templateEmail    TemplateMensagem?  @relation("RegraTemplateEmail", fields: [templateEmailId], references: [id], onDelete: SetNull)
  envios           EnvioLembrete[]

  @@index([clinicaId, ativo])
  @@map("regras_lembrete")
}

model TemplateMensagem {
  id                    String  @id @default(uuid()) @db.Uuid
  clinicaId             String  @db.Uuid
  canal                 String
  tipo                  String
  nome                  String
  assunto               String?
  corpo                 String
  whatsappNomeTemplate  String?
  whatsappIdioma        String  @default("pt_BR")
  whatsappCategoria     String  @default("utility")
  ativo                 Boolean @default(true)
  sistema               Boolean @default(false)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  clinica            Clinica         @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  regrasWhatsapp     RegraLembrete[] @relation("RegraTemplateWhatsapp")
  regrasEmail        RegraLembrete[] @relation("RegraTemplateEmail")
  envios             EnvioLembrete[]

  @@index([clinicaId, canal])
  @@map("templates_mensagem")
}

model CustoEnvio {
  id        String  @id @default(uuid()) @db.Uuid
  clinicaId String  @db.Uuid
  canal     String
  categoria String
  valor     Decimal @db.Decimal(12, 4)
  moeda     String  @default("BRL")
  ativo     Boolean @default(true)
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clinica Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@unique([clinicaId, canal, categoria])
  @@index([clinicaId])
  @@map("custos_envio")
}

model EnvioLembrete {
  id                  String    @id @default(uuid()) @db.Uuid
  clinicaId           String    @db.Uuid
  agendamentoId       String    @db.Uuid
  regraId             String?   @db.Uuid
  templateId          String?   @db.Uuid
  canal               String
  destinatarioTipo    String
  destinatarioId      String
  destinatarioNome    String
  destinatarioContato String
  tipoLembrete        String
  status              String
  chaveIdempotencia   String
  provedorMessageId   String?
  erro                String?
  custo               Decimal   @default(0) @db.Decimal(12, 4)
  custoEstimado       Boolean   @default(true)
  tentativas          Int       @default(0)
  processarEm         DateTime
  enviadoEm           DateTime?
  entregueEm          DateTime?
  lidoEm              DateTime?
  metadados           Json?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  clinica     Clinica           @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  agendamento Agendamento       @relation(fields: [agendamentoId], references: [id], onDelete: Restrict)
  regra       RegraLembrete?    @relation(fields: [regraId], references: [id], onDelete: SetNull)
  template    TemplateMensagem? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([clinicaId, chaveIdempotencia])
  @@index([clinicaId, status, processarEm])
  @@index([clinicaId, criadoEm])
  @@index([agendamentoId])
  @@index([provedorMessageId])
  @@map("envios_lembrete")
}
